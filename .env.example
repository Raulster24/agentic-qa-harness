# Azure OpenAI (chat completions deployment with tool-calling support, e.g. gpt-4.1 / gpt-4o)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# System under test
SUT_BASE_URL=http://localhost:3333

# Agent behavior
# HEADLESS=0 to watch the agent drive the browser during a demo
HEADLESS=1
MAX_AGENT_TURNS=40
