# Model: Anthropic API. Create a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Default is claude-opus-4-8. Use claude-sonnet-4-6 for faster, lower-cost runs.
ANTHROPIC_MODEL=claude-opus-4-8

# System under test
SUT_BASE_URL=http://localhost:3333

# Agent behavior
# HEADLESS=0 to watch the agent drive the browser during a demo
HEADLESS=1
MAX_AGENT_TURNS=60
